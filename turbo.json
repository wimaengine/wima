{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "types",
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "test": {
      "outputs": []
    },
    "types": {
      "outputs": [
        "types/**"
      ]
    },
    "//#build:root": {
      "dependsOn": [
        "//#types:root"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "//#build:docs": {
      "outputs": [
        "docs/**"
      ]
    },
    "//#types:root": {
      "outputs": [
        "types/**"
      ]
    }
  }
}
