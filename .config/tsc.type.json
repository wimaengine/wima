{
  "extends": "./tsc.lint.json",
  "include": [
    "../src/index.js",
    "../packages/**/*"
  ],
  "exclude": [
    "../packages/**/tests/**"
  ],
  "compilerOptions": {
    "allowJs": true,
    "declaration": true,
    "declarationDir": "../types",
    "emitDeclarationOnly": true,
    "noEmit": false
  }
}
